# PSX Monitor - Environment Variables
# Every variable is optional. With none set, the site runs in demo mode:
# seeded AI snapshot (public/data/ai-snapshot.json) + portfolio in localStorage.

# Supabase (optional — enables sign-in and portfolio sync across devices)
# Get these from: supabase.com → your project → Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Anthropic (optional — server-side key for live analysis for signed-in users)
# Read only by the /api/claude serverless function; never bundled into the client.
# Visitors can instead add their own key in the site's AI settings (BYOK).
ANTHROPIC_API_KEY=
# Set to "server" once ANTHROPIC_API_KEY is configured on the deployment.
VITE_AI_MODE=
